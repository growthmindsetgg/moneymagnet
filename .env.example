# All variables are optional. HoodTier never invents data: a factor whose source is not
# configured shows "no data — <reason>" (e.g. "Helius key not set") and is excluded from the score.

# --- Persistence (stale snapshots, Transfer-log replay, liquidity history, manual checks) ---
# Upstash Redis REST (free tier). Vercel's Upstash integration sets the KV_* names; either works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Fallback when Upstash is not set: Postgres (Neon) — a `kv` table (key, value jsonb, expires_at).
# The Vercel Neon integration sets DATABASE_URL (POSTGRES_URL also works).
DATABASE_URL=
# Without either: local dev uses .data/kv files, Vercel uses per-instance memory (not durable).

# --- Solana ---
# Helius (free tier): top holders, wallet age, funding clusters, creator history, curve trades.
HELIUS_API_KEY=
# Public Solana RPC used for the pump.fun bonding-curve read (default https://api.mainnet-beta.solana.com)
SOLANA_RPC_URL=
# pump.fun intel feed. Defaults to the keyless three.ws JSON-RPC MCP backend
# (https://three.ws/api/pump-fun-mcp) that @three-ws/pumpfun-mcp bridges to; override only if needed.
PUMPFUN_FEED_URL=
PUMPFUN_FEED_KEY=

# --- Robinhood Chain ---
# JSON-RPC endpoint (default https://rpc.mainnet.chain.robinhood.com)
ROBINHOOD_RPC_URL=
# Extra LP locker contracts (comma-separated 0x addresses) counted as "locked" next to burn addresses.
LP_LOCKER_ADDRESSES=
# Time budget per request for advancing the Transfer-log holder replay (ms, default 20000).
REPLAY_BUDGET_MS=

# --- Base (8453) and Monad (143) — v3 ---
# Optional private RPCs, tried before the public lists in data/base-rpc-endpoints.json / data/monad-rpc-endpoints.json.
BASE_RPC_URL=
MONAD_RPC_URL=
# Basescan via the Etherscan v2 API (free key): contract creator + creation time, verified source. Without it the
# Base deployer comes from GoPlus only. See docs/chains/base.md.
BASESCAN_API_KEY=
# nad.fun agent API (Monad launchpad): keyless is 10 requests/min; a key (X-API-Key) raises it to 100/min.
NAD_API_KEY=

# --- Social panel (information only, no score effect) ---
# RobinX (api.robinx.io, Robinhood Chain CAs): the free report tier (25/day per IP) is used first. Paid calls
# (the 24h mention tape $0.02, Telegram first-call $0.03, or the paid report $0.05 when the free quota is spent)
# need ONE of: an x402 wallet private key holding USDC on Base, or a RobinX API key (30-day plan).
ROBINX_WALLET_KEY=
ROBINX_API_KEY=
# Spend cap per analysis in USD (default 0.05). Results are cached 10 minutes.
ROBINX_MAX_USD=
# Time the social sources may take inside one request (ms, default 10000).
SOCIAL_BUDGET_MS=

# --- Time Machine ---
# Per-request reconstruction budgets for the pasted token (Helius transactions / Robinhood Transfer logs)
# and the time a request waits before finishing the rebuild in the background.
TM_REQUEST_MAX_TX=
TM_REQUEST_MAX_LOGS=
TM_REQUEST_BUDGET_MS=
# Library build budgets per archetype (pnpm timemachine:build; defaults 4000 / 400000).
TM_MAX_TX=
TM_MAX_LOGS=
# Shared secret Vercel sends to the weekly archetype refresh cron (/api/cron/timemachine).
CRON_SECRET=

# --- Production verification ---
# Lets scripts/verify-prod-env.mjs simulate a HoodScan outage on production: the request must send
# x-hoodtier-simulate-token equal to this value (≥ 16 chars).
HOODTIER_SIMULATE_TOKEN=

# --- Misc ---
# Per-source HTTP timeout in milliseconds (default 12000)
SOURCE_TIMEOUT_MS=
# One analysis stops waiting at this budget (ms, default 45000; route maxDuration is 60s), and each source at
# SOURCE_BUDGET_MS (default 30000) — a source past either is reported failed and served stale when it can be.
ANALYSIS_BUDGET_MS=
SOURCE_BUDGET_MS=
# Top-holder classification step (getCode + vesting / locker / Safe probes + the founder's sell history), ms,
# default 12000, inside the analysis budget. Past it the classes are not applied and the normal caps stand.
HOLDER_CLASS_BUDGET_MS=
# Test-only fault injection (?simulate=hoodscan-down). Never set this in production.
HOODTIER_ALLOW_SIMULATE=

# Optional: V4Quoter gas cap for the Robinhood sell simulation (default 3000000)
# SIM_QUOTE_GAS=

# Canonical domain (optional, not secret). When set and the host answers 2xx at build/start, every path on
# hoodtier.vercel.app 308-redirects to it and <link rel="canonical"> / Open Graph URLs use it. No-op otherwise.
HOODTIER_CANONICAL_HOST=moneymagnet.vercel.app
