{
  "name": "hoodtier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:api": "node scripts/verify-api.mjs",
    "record:fixtures": "tsx scripts/record-fixtures.ts",
    "replay": "node --env-file-if-exists=.env.local --import tsx scripts/replay.ts",
    "verify:stability": "node scripts/stability.mjs",
    "verify:prod-env": "node scripts/verify-prod-env.mjs",
    "verify:kv": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/kv.contract.test.ts",
    "verification": "tsx scripts/verification.ts",
    "distribution": "node --env-file-if-exists=.env.local --import tsx scripts/distribution.ts",
    "verify:prod-verification": "node scripts/prod-verification.mjs",
    "timemachine:build": "node --env-file-if-exists=.env.local --import tsx scripts/build-archetypes.ts",
    "timemachine:prewarm": "node --env-file-if-exists=.env.local --import tsx scripts/prewarm-timemachine.ts",
    "backtest:social": "node --env-file-if-exists=.env.local --import tsx scripts/backtest-social.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "bs58": "^6.0.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "lighthouse": "12.8.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
